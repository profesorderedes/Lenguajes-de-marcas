<?xml version="1.0" encoding="UTF-8"?>

<taller xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="ejemplo02.xsd">

    <coche>Peugeot 206</coche>
    <coche>Seat Ibiza</coche>
    <coche>Volkswagen Golf</coche>

    <nombre_taller>Motor Son Ferrer</nombre_taller>

    <!-- La antigüedad estará entre 0 y 120, ambos inclusive -->
    <antiguedad>20</antiguedad>

    <!-- El nombre del propietario tendrá entre 5 y 40 caracteres -->
    <propietario>Manuel Antonio López</propietario>

    <!-- Tipo de empresa: Autónomo, SL, SA -->
    <tipo_empresa>Autónomo</tipo_empresa>

    <!-- La tarifa de reparación de un pinchazo es de 10,5 euros  -->
    <tarifa_pinchazos>10.5</tarifa_pinchazos>

    <!-- El dni es un atributo obligatorio y la titulación no lo es -->
    <mecanico dni="20199299R" titulacion="grado superior">Jaime Pérez</mecanico>

    <!-- Dentro de isla puede aparecer el nombre de alguna de las islas de Baleares -->
    <isla>
        <Formentera />
    </isla>

    <!-- La etiqueta "multimarca" indica que el taller no es
     un concesionario oficial -->
    <multimarca/>

    <!-- Pueden haber 0 o más etiquetas categoría, que siempre
     estarán vacías con un atributo tipo. -->
    <categoria tipo="ChapaYPintura" />
    <categoria tipo="Electromecánica" />
    <categoria tipo="Estructura" />

    <descripcion>
        El taller se encuentra en la <i>calle Cóndor, 9</i>, y realiza trabajos de todo tipo, especialmente <b>chapa y pintura</b>, <b>electromecánica</b> y <b>estructura</b>.
    </descripcion>

</taller>